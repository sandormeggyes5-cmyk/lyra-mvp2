# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/physiopilot

# API
PORT=3001
NODE_ENV=development

# better-auth — mindestens 32 zufällige Zeichen (z.B. openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string

# CORS — kommagetrennte Origins (kein trailing slash)
TRUSTED_ORIGINS=http://localhost:5173

# Frontend-URL für Magic Links
FRONTEND_URL=http://localhost:5173
