generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  therapist
}

// ── DOMAIN MODELS ────────────────────────────────────────────────────────────

model Practice {
  id                 String               @id @default(cuid())
  name               String
  subscriptionStatus String               @default("trial")
  createdAt          DateTime             @default(now())
  users              User[]
  patients           Patient[]
  adaptations        ExerciseAdaptation[]
}

// practiceId nullable: better-auth erstellt den User zuerst (ohne Praxis-Kontext),
// die Registration-Route setzt practiceId + role direkt danach in einer DB-Transaktion.
// Alle geschützten Routen prüfen, dass practiceId gesetzt ist.
model User {
  id            String            @id
  practiceId    String?
  practice      Practice?         @relation(fields: [practiceId], references: [id])
  email         String            @unique
  emailVerified Boolean           @default(false)
  name          String
  image         String?
  role          UserRole          @default(therapist)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  sessions      Session[]
  accounts      Account[]
  programs      ExerciseProgram[]
}

model Patient {
  id                 String            @id @default(cuid())
  practiceId         String
  practice           Practice          @relation(fields: [practiceId], references: [id])
  name               String
  emailOrPhone       String?
  dateOfBirth        DateTime?
  magicLinkToken     String            @unique
  magicLinkExpiresAt DateTime?
  createdAt          DateTime          @default(now())
  programs           ExerciseProgram[]
  chatMessages       ChatMessage[]
}

model Exercise {
  id                 String               @id @default(cuid())
  nameDe             String
  descriptionDe      String
  videoUrl           String?
  thumbnailUrl       String?
  muscleGroups       String[]
  bodyRegion         String
  difficulty         Int
  defaultSets        Int
  defaultReps        Int
  defaultHoldSeconds Int?
  programItems       ProgramExercise[]
  sessionLogs        SessionLog[]
  adaptations        ExerciseAdaptation[]

  // ── Fachliche Freigabe ──────────────────────────────────────────────────
  // Solange isValidated = false, darf die Übung laut programs.ts NICHT
  // verordnet werden (siehe unvalidatedExercisesAllowed() in lib/featureFlags.ts).
  isValidated Boolean   @default(false)
  validatedBy String? // Name + Qualifikation der prüfenden Person
  validatedAt DateTime?
  sourceNote  String? // Herkunft: "LLM-Entwurf", "Praxis X", "Fachliteratur"

  // ── Taxonomie ────────────────────────────────────────────────────────────
  exerciseType String // "Mobilisation" | "Kräftigung" | "Dehnung" | "Stabilisation" | "Koordination" | "Atmung"
  position     String // "Rückenlage" | "Bauchlage" | "Seitlage" | "Vierfüßler" | "Sitz" | "Stand"
  equipment    String[] @default([]) // "ohne" | "Theraband" | "Ball" | "Stuhl" | "Wand" | "Matte"
}

model ExerciseProgram {
  id          String            @id @default(cuid())
  patientId   String
  patient     Patient           @relation(fields: [patientId], references: [id])
  therapistId String
  therapist   User              @relation(fields: [therapistId], references: [id])
  name        String
  notes       String?
  createdAt   DateTime          @default(now())
  items       ProgramExercise[]
  logs        SessionLog[]
}

model ProgramExercise {
  id               String                      @id @default(cuid())
  programId        String
  program          ExerciseProgram             @relation(fields: [programId], references: [id])
  exerciseId       String
  exercise         Exercise                    @relation(fields: [exerciseId], references: [id])
  sets             Int
  reps             Int
  holdSeconds      Int?
  frequencyPerWeek Int
  order            Int
  // Freie Anmerkung des Therapeuten zu dieser Übung für diesen Patienten.
  therapistNote    String?
  adaptations      ProgramExerciseAdaptation[]
}

// ── ÜBUNGS-ANPASSUNGEN ───────────────────────────────────────────────────────
// Regulatorisch verbindlich (siehe TASK_ADAPTATIONS.md): Die Zuweisung einer
// Anpassung ist IMMER eine explizite, manuelle Entscheidung des Therapeuten.
// Es darf keine Logik geben, die eine ExerciseAdaptation automatisch anhand
// von Patientenmerkmalen (BMI, Alter, Diagnose, ...) vorschlägt oder zuweist.

model ExerciseAdaptation {
  id         String   @id @default(cuid())
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])

  // Kurzlabel für die Therapeuten-Auswahlliste, z. B. "Hohlkreuz"
  labelDe String

  // Der Hinweistext, den der Patient sieht
  instructionDe String

  // Gruppierung für die UI: "haltung" | "koerperbau" | "beweglichkeit" | "hilfsmittel" | "schonung"
  category String

  // Optional: abweichendes Demo-Medium für diese Variante (Phase 3, vorerst null)
  videoUrl String?

  // true = von uns geseedet, false = von der Praxis selbst angelegt
  isSystem Boolean @default(true)

  // Nur gesetzt bei praxiseigenen Anpassungen (isSystem = false).
  // Mandantentrenner: praxiseigene Anpassungen dürfen niemals in anderen
  // Praxen sichtbar oder zuweisbar sein — siehe programs.ts-Validierung.
  practiceId String?
  practice   Practice? @relation(fields: [practiceId], references: [id])

  order     Int      @default(0)
  createdAt DateTime @default(now())

  selections ProgramExerciseAdaptation[]

  // ── Fachliche Freigabe ──────────────────────────────────────────────────
  // Solange isValidated = false, darf die Anpassung laut programs.ts NICHT
  // einem Patienten zugewiesen werden (assertAdaptationsAreAssignable()).
  isValidated Boolean   @default(false)
  validatedBy String?
  validatedAt DateTime?
  sourceNote  String?
}

// Verknüpfungstabelle: welche Anpassung hat der Therapeut für diese
// konkrete Übung in diesem konkreten Programm ausgewählt?
model ProgramExerciseAdaptation {
  id                String             @id @default(cuid())
  programExerciseId String
  programExercise   ProgramExercise    @relation(fields: [programExerciseId], references: [id], onDelete: Cascade)
  adaptationId      String
  adaptation        ExerciseAdaptation @relation(fields: [adaptationId], references: [id])
  createdAt         DateTime           @default(now())

  @@unique([programExerciseId, adaptationId])
}

model SessionLog {
  id          String          @id @default(cuid())
  programId   String
  program     ExerciseProgram @relation(fields: [programId], references: [id])
  exerciseId  String
  exercise    Exercise        @relation(fields: [exerciseId], references: [id])
  completedAt DateTime        @default(now())
  painLevel   Int?
  note        String?
}

model ChatMessage {
  id        String   @id @default(cuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id])
  role      String
  content   String
  createdAt DateTime @default(now())
}

// ── BETTER-AUTH TABLES ────────────────────────────────────────────────────────

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([accountId, providerId])
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}
