# Kopiere diese Datei nach .env und fülle die Werte aus.

# PostgreSQL — lokal z. B. postgresql://postgres:postgres@localhost:5432/physiopilot
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/physiopilot"

# Zufälliger Secret für better-auth (min. 32 Zeichen)
# Generieren: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="HIER_GEHEIMEN_WERT_EINTRAGEN"

# URL des Frontends (für CORS und Magic-Link-Generierung)
APP_URL="http://localhost:5173"

# Anthropic API Key (für Kai-Chat)
ANTHROPIC_API_KEY="sk-ant-..."

# Port des API-Servers (optional, Standard: 3000)
PORT=3000

# Nur außerhalb von production wirksam (NODE_ENV !== "production"):
# erlaubt das Verordnen fachlich noch nicht freigegebener Übungen/Anpassungen
# zu Testzwecken. In production immer ignoriert, egal wie gesetzt.
ALLOW_UNVALIDATED_EXERCISES=false
